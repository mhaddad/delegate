{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@delegate/eventos": ["./packages/eventos/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*",
    "packages/**/*",
    "scripts/**/*",
    "testes/**/*",
    "avaliacao/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
