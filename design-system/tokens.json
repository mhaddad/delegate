{
  "$description": "Delegate · tokens de design (formato W3C Design Tokens). Espelha tokens.css.",
  "cor": {
    "$type": "color",
    "marca": {
      "verde": { "$value": "#7BCC90", "$description": "Porta do símbolo sobre fundo escuro" },
      "dourado": { "$value": "#E0B65D", "$description": "Maçaneta do símbolo sobre fundo escuro" }
    },
    "neutro": {
      "palco": { "$value": "#F4EFE6", "$description": "Superfícies" },
      "branco": { "$value": "#FFFEFA", "$description": "Cartões e campos" },
      "tinta": { "$value": "#1D2430", "$description": "Texto" },
      "cinza": { "$value": "#647080", "$description": "Texto secundário; 4,40:1 sobre Palco, só em texto grande" },
      "linha": { "$value": "#E6E2DA", "$description": "Bordas e divisórias" },
      "bastidores": { "$value": "#0F1B2D", "$description": "Tecnologia, consola, fundo do logótipo escuro" },
      "bastidores-texto": { "$value": "#C3CCD8", "$description": "Texto secundário sobre Bastidores" }
    },
    "estado": {
      "verde": { "$value": "#1A7040", "$description": "Ação concluída · Henriques" },
      "verde-suave": { "$value": "#DCEFE2" },
      "dourado": { "$value": "#8A6210", "$description": "Autorização · Cofre" },
      "dourado-suave": { "$value": "#F6EDCF" },
      "terracota": { "$value": "#B4492A", "$description": "Atenção · alertas" },
      "terracota-suave": { "$value": "#F6E2DC" },
      "ciano": { "$value": "#167A76", "$description": "Reserva: definido no estudo, sem papel atribuído" },
      "ciano-suave": { "$value": "#D9EFEC" }
    },
    "papel": {
      "fundo": { "$value": "{cor.neutro.palco}" },
      "superficie": { "$value": "{cor.neutro.branco}" },
      "texto": { "$value": "{cor.neutro.tinta}" },
      "texto-secundario": { "$value": "{cor.neutro.cinza}" },
      "borda": { "$value": "{cor.neutro.linha}" },
      "acao": { "$value": "{cor.estado.verde}" },
      "acao-fundo": { "$value": "{cor.estado.verde-suave}" },
      "autorizacao": { "$value": "{cor.estado.dourado}" },
      "autorizacao-fundo": { "$value": "{cor.estado.dourado-suave}" },
      "atencao": { "$value": "{cor.estado.terracota}" },
      "atencao-fundo": { "$value": "{cor.estado.terracota-suave}" }
    }
  },
  "tipografia": {
    "familia": { "$type": "fontFamily", "$value": ["Manrope", "Arial", "sans-serif"] },
    "peso": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medio": { "$value": 500 },
      "semi": { "$value": 600 },
      "forte": { "$value": 700 },
      "extra": { "$value": 800 }
    },
    "estilo": {
      "$type": "typography",
      "display": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 700, "fontSize": "6.5rem", "lineHeight": 0.98, "letterSpacing": "-0.045em" }, "$description": "Fluido: clamp(3rem, 7vw, 6.5rem)" },
      "titulo": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 700, "fontSize": "2.4rem", "lineHeight": 1.1, "letterSpacing": "-0.045em" } },
      "destaque": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 700, "fontSize": "3rem", "lineHeight": 1.05, "letterSpacing": "-0.05em" } },
      "interface": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 500, "fontSize": "1.5625rem", "lineHeight": 1.35, "letterSpacing": "-0.03em" } },
      "lead": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 400, "fontSize": "1.1875rem", "lineHeight": 1.55, "letterSpacing": "0" } },
      "corpo": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.55, "letterSpacing": "0" } },
      "pequeno": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 400, "fontSize": "0.8125rem", "lineHeight": 1.5, "letterSpacing": "0" } },
      "etiqueta": { "$value": { "fontFamily": "{tipografia.familia}", "fontWeight": 700, "fontSize": "0.75rem", "lineHeight": 1.4, "letterSpacing": "0.12em" }, "$description": "Maiúsculas, até três palavras" }
    }
  },
  "forma": {
    "raio": {
      "$type": "dimension",
      "pequeno": { "$value": "10px" },
      "medio": { "$value": "14px" },
      "grande": { "$value": "18px" },
      "palco": { "$value": "24px" },
      "pilula": { "$value": "99px" }
    },
    "sombra": {
      "$type": "shadow",
      "elevacao": { "$value": { "color": "#17203318", "offsetX": "0", "offsetY": "22px", "blur": "60px", "spread": "0" } }
    }
  }
}
